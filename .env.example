# Nyyo inbox -> CRM kit: your keys. setup copies this file to .env once (private to you, never shared).
# Fill only what your settings use. Leave the rest as they are. Never send this file to anyone.

# AI (only if [ai] provider = openai or anthropic). Billed to your own account.
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Google Sheet (only if google_sheet = yes): the web app URL and the secret you chose in the Sheet script
GOOGLE_SHEET_WEBHOOK_URL=your-sheet-web-app-url
GOOGLE_SHEET_WEBHOOK_SECRET=your-long-random-secret

# CRM (only the one you picked in [send] crm)
HUBSPOT_TOKEN=your-hubspot-private-app-token
PIPEDRIVE_API_TOKEN=your-pipedrive-api-token
AIRTABLE_TOKEN=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id
AIRTABLE_TABLE=Leads

# Alerts (only if alerts = slack, telegram or both)
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
